GHSA-8mjj-2r7p-4hg2 (CVE-2026-129474): backtraces read __call/__callStatic trampoline args from
the wrong stack slots (stale, possibly freed zvals); 8.5-only Zend test dropped.
https://github.com/php/php-src/commit/03c403286d9440c2b3a840812652be4e221d1be7

diff -urNp a/sapi/phpdbg/phpdbg.c b/sapi/phpdbg/phpdbg.c
--- a/sapi/phpdbg/phpdbg.c
+++ b/sapi/phpdbg/phpdbg.c
@@ -120,6 +120,7 @@ static inline void php_phpdbg_globals_ct
 	pg->flags = PHPDBG_DEFAULT_FLAGS;
 	memset(pg->io, 0, sizeof(pg->io));
 	pg->frame.num = 0;
+	pg->frame.generator = 0;
 	pg->sapi_name_ptr = NULL;
 	pg->unclean_eval = 0;
 
diff -urNp a/sapi/phpdbg/phpdbg_frame.c b/sapi/phpdbg/phpdbg_frame.c
--- a/sapi/phpdbg/phpdbg_frame.c
+++ b/sapi/phpdbg/phpdbg_frame.c
@@ -56,6 +56,12 @@ zend_string *phpdbg_compile_stackframe(z
 	uint32_t i = 0, first_extra_arg = op_array->num_args, num_args = ZEND_CALL_NUM_ARGS(ex);
 	zval *p = ZEND_CALL_ARG(ex, 1);
 
+	if (ex->func->op_array.fn_flags & ZEND_ACC_CALL_VIA_TRAMPOLINE) {
+		/* A __call/__callStatic trampoline doesn't move extra args
+		 * behind the CVs and TMPs (see i_init_func_execute_data()). */
+		first_extra_arg = num_args;
+	}
+
 	if (op_array->scope) {
 		smart_str_append(&s, op_array->scope->name);
 		smart_str_appends(&s, "::");
@@ -86,6 +92,8 @@ zend_string *phpdbg_compile_stackframe(z
 		smart_str_appends(&s, " [internal function]");
 	}
 
+	smart_str_0(&s);
+
 	return s.s;
 }
 
