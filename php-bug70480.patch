diff --git a/ext/standard/url.c b/ext/standard/url.c
--- a/ext/standard/url.c
+++ b/ext/standard/url.c
@@ -321,7 +321,7 @@ PHPAPI php_url *php_url_parse_ex(char const *str, int length)
 	nohost:
 	
 	if ((p = memchr(s, '?', (ue - s)))) {
-		pp = strchr(s, '#');
+		pp = memchr(s, '#', (ue - s));
 
 		if (pp && pp < p) {
 			if (pp - s) {
