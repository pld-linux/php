From: Stanislav Malyshev <stas@php.net>
Date: Sun Mar 27 14:22:19 2016 -0700
Subject: [PATCH] Fix bug #71798 - Integer Overflow in php_raw_url_encode

5.4 backport: https://github.com/shivammathur/php-src-backports/commit/b18c22aa49d6a213070892cf58b694b48aa226e7
---
diff --git a/ext/standard/url.c b/ext/standard/url.c
--- a/ext/standard/url.c
+++ b/ext/standard/url.c
@@ -600,7 +600,7 @@ PHPAPI int php_url_decode(char *str, int len)
  */
 PHPAPI char *php_raw_url_encode(char const *s, int len, int *new_length)
 {
-	register int x, y;
+	register size_t x, y;
 	unsigned char *str;
 
 	str = (unsigned char *) safe_emalloc(3, len, 1);
