From: Stanislav Malyshev <stas@php.net>
Date: Sun May 15 23:26:51 2016 -0700
Subject: [PATCH] Fix bug #72135 - don't create strings with lengths outside int range

5.5 backport: https://github.com/shivammathur/php-src-backports/commit/d59f0aea3e2e0ebb0b4a97551d89dc9ad214fcd4
---
diff --git a/ext/standard/html.c b/ext/standard/html.c
--- a/ext/standard/html.c
+++ b/ext/standard/html.c
@@ -1449,6 +1449,10 @@ static void php_html_entities(INTERNAL_FUNCTION_PARAMETERS, int all)
 	}
 
 	replaced = php_escape_html_entities_ex(str, str_len, &new_len, all, (int) flags, hint_charset, double_encode TSRMLS_CC);
+	if (new_len > INT_MAX) {
+		efree(replaced);
+		RETURN_FALSE;
+	}
 	RETVAL_STRINGL(replaced, (int)new_len, 0);
 }
 /* }}} */
