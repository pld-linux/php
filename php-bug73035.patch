From: Stanislav Malyshev <stas@php.net>
Date: Sun Sep 11 21:37:44 2016 -0700
Subject: [PATCH] Fix bug #73035 (Out of bound when verify signature of tar phar in phar_parse_tarfile)

5.5 backport: https://github.com/shivammathur/php-src-backports/commit/dacf6ad8c122b385c71fc90577956a2c1e56fd1a
---
diff --git a/ext/phar/tar.c b/ext/phar/tar.c
--- a/ext/phar/tar.c
+++ b/ext/phar/tar.c
@@ -366,7 +366,7 @@ bail:
 			}
 			curloc = php_stream_tell(fp);
 			read = php_stream_read(fp, buf, size);
-			if (read != size) {
+			if (read != size || read <= 8) {
 				if (error) {
 					spprintf(error, 4096, "phar error: tar-based phar \"%s\" signature cannot be read", fname);
 				}
