From: Nikita Popov <nikic@php.net>
Date: Sat Oct 8 01:04:22 2016 +0200
Subject: [PATCH] Fix bug #73192

5.4 backport: https://github.com/shivammathur/php-src-backports/commit/9fe244407a1f00d7329d655c82a0c23ba276c995
PLD: with the rest of upstream "Make php_url_parse_ex() respect length argument" (Ubuntu trusty CVE-2016-10397-2.patch), applied by hand to the url.c already changed by later fixes
---
diff --git a/ext/standard/tests/url/bug73192.phpt b/ext/standard/tests/url/bug73192.phpt
new file mode 100644
--- /dev/null
+++ b/ext/standard/tests/url/bug73192.phpt
@@ -0,0 +1,30 @@
+--TEST--
+Bug #73192: parse_url return wrong hostname
+--FILE--
+<?php
+
+var_dump(parse_url("http://example.com:80#@google.com/"));
+var_dump(parse_url("http://example.com:80?@google.com/"));
+
+?>
+--EXPECT--
+array(4) {
+  ["scheme"]=>
+  string(4) "http"
+  ["host"]=>
+  string(11) "example.com"
+  ["port"]=>
+  int(80)
+  ["fragment"]=>
+  string(12) "@google.com/"
+}
+array(4) {
+  ["scheme"]=>
+  string(4) "http"
+  ["host"]=>
+  string(11) "example.com"
+  ["port"]=>
+  int(80)
+  ["query"]=>
+  string(12) "@google.com/"
+}
