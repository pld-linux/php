From: Stanislav Malyshev <stas@php.net>
Date: Tue Oct 11 13:37:47 2016 -0700
Subject: [PATCH] Fix bug #73276 - crash in openssl_random_pseudo_bytes function

Upstream: https://github.com/php/php-src/commit/85a22a0af0722ef3a8d49a056a0b2b18be1fb981

Upstream: https://github.com/php/php-src/commit/7dc8b5e7aefce963a7a222c48ee3506725c4776b

5.4 backport: https://github.com/shivammathur/php-src-backports/commit/9228f7d15d7786e2d05d02a2033e66678d47ef51
---
diff --git a/ext/openssl/openssl.c b/ext/openssl/openssl.c
--- a/ext/openssl/openssl.c
+++ b/ext/openssl/openssl.c
@@ -5286,16 +5286,16 @@ PHP_FUNCTION(openssl_random_pseudo_bytes)
 		return;
 	}
 
-	if (buffer_length <= 0) {
-		RETURN_FALSE;
-	}
-
 	if (zstrong_result_returned) {
 		zval_dtor(zstrong_result_returned);
 		ZVAL_BOOL(zstrong_result_returned, 0);
 	}
 
-	buffer = emalloc(buffer_length + 1);
+	if (buffer_length <= 0 || buffer_length > INT_MAX) {
+		RETURN_FALSE;
+	}
+
+	buffer = safe_emalloc(buffer_length, 1, 1);
 
 #ifdef PHP_WIN32
 	/* random/urandom equivalent on Windows */
