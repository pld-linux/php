From 59ef5a414dc6392088e772aea39a393a81563a0f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Arkadiusz=20Mi=C5=9Bkiewicz?= <arekm@maven.pl>
Date: Thu, 22 Oct 2026 10:40:31 +0200
Subject: [PATCH] Fix #73533: Invalid memory access in php_libxml_xmlCheckUTF8

The int index overflows for strings over 2 GiB (e.g. passed to SOAP
encoding), so the scan reads out of bounds.

Origin: upstream, https://github.com/php/php-src/commit/498eb8e0529fbe1dd8a91ae3ee8592eda868d3aa
Bug: https://bugs.php.net/73533
PLD: 7.2: taken from packages/php branch PHP_7_1
---
 ext/libxml/libxml.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ext/libxml/libxml.c b/ext/libxml/libxml.c
index 744e2b65..2d4553c9 100644
--- a/ext/libxml/libxml.c
+++ b/ext/libxml/libxml.c
@@ -1220,7 +1220,7 @@ static PHP_FUNCTION(libxml_set_external_entity_loader)
 /* {{{ Common functions shared by extensions */
 int php_libxml_xmlCheckUTF8(const unsigned char *s)
 {
-	int i;
+	size_t i;
 	unsigned char c;
 
 	for (i = 0; (c = s[i++]);) {
