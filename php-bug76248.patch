From: Stanislav Malyshev <stas@php.net>
Date: Sun Apr 22 22:01:35 2018 -0700
Subject: [PATCH] Fix bug #76248 - Malicious LDAP-Server Response causes Crash

5.5 backport: https://github.com/shivammathur/php-src-backports/commit/f742a403818d9b3a809aad5dea341eb7d3cd4421
---
diff --git a/ext/ldap/ldap.c b/ext/ldap/ldap.c
--- a/ext/ldap/ldap.c
+++ b/ext/ldap/ldap.c
@@ -1026,7 +1026,11 @@ PHP_FUNCTION(ldap_get_entries)
 
 		add_assoc_long(tmp1, "count", num_attrib);
 		dn = ldap_get_dn(ldap, ldap_result_entry);
-		add_assoc_string(tmp1, "dn", dn, 1);
+		if (dn) {
+			add_assoc_string(tmp1, "dn", dn, 1);
+		} else {
+			add_assoc_null(tmp1, "dn");
+		}
 #if (LDAP_API_VERSION > 2000) || HAVE_NSLDAP || HAVE_ORALDAP || WINDOWS
 		ldap_memfree(dn);
 #else
