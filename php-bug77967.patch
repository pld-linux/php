From: Stanislav Malyshev <stas@php.net>
Date: Mon May 27 18:04:00 2019 -0700
Subject: [PATCH] Fix bug #77967 - Bypassing open_basedir restrictions via file uris

5.4 backport: https://github.com/shivammathur/php-src-backports/commit/6051a6cc8d84999e7d25afeb7ed2e20618b53e95
---
diff --git a/ext/sqlite3/sqlite3.c b/ext/sqlite3/sqlite3.c
--- a/ext/sqlite3/sqlite3.c
+++ b/ext/sqlite3/sqlite3.c
@@ -1992,6 +1992,15 @@ static int php_sqlite3_authorizer(void *autharg, int access_type, const char *ar
 		{
 			if (memcmp(arg3, ":memory:", sizeof(":memory:")) && *arg3) {
 				TSRMLS_FETCH();
+				if (strncmp(arg3, "file:", 5) == 0) {
+					/* starts with "file:" */
+					if (!arg3[5]) {
+						return SQLITE_DENY;
+					}
+					if (php_check_open_basedir(arg3 + 5 TSRMLS_CC)) {
+						return SQLITE_DENY;
+					}
+				}
 
 #if PHP_API_VERSION < 20100412
 				if (PG(safe_mode) && (!php_checkuid(arg3, NULL, CHECKUID_CHECK_FILE_AND_DIR))) {
