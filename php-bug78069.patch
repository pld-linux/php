From: Stanislav Malyshev <stas@php.net>
Date: Mon May 27 16:32:42 2019 -0700
Subject: [PATCH] Fix bug #78069 - Out-of-bounds read in iconv.c:_php_iconv_mime_decode() due to integer overflow

5.5 backport: https://github.com/shivammathur/php-src-backports/commit/072faf99941409d86ddf45a6c6f5108f452a8afc
---
diff --git a/ext/iconv/iconv.c b/ext/iconv/iconv.c
--- a/ext/iconv/iconv.c
+++ b/ext/iconv/iconv.c
@@ -1580,7 +1580,9 @@ static php_iconv_err_t _php_iconv_mime_decode(smart_str *pretval, const char *st
 							 * we can do at this point. */
 							if (*(p1 + 1) == '=') {
 								++p1;
-								--str_left;
+								if (str_left > 1) {
+									--str_left;
+								}
 							}
 
 							err = _php_iconv_appendl(pretval, encoded_word, (size_t)((p1 + 1) - encoded_word), cd_pl);
