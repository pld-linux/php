From: Jakub Zelenka <bukka@php.net>
Date: Sat Oct 12 15:56:16 2019 +0100
Subject: [PATCH] Fix bug #78599 (env_path_info underflow can lead to RCE) (CVE-2019-11043)

5.4 backport: https://github.com/shivammathur/php-src-backports/commit/144dbe51f26362eaee39a5558a6510a5012c584f
---
diff --git a/sapi/fpm/fpm/fpm_main.c b/sapi/fpm/fpm/fpm_main.c
--- a/sapi/fpm/fpm/fpm_main.c
+++ b/sapi/fpm/fpm/fpm_main.c
@@ -1210,8 +1210,8 @@ static void init_request_info(TSRMLS_D)
 								path_info = script_path_translated + ptlen;
 								tflag = (slen != 0 && (!orig_path_info || strcmp(orig_path_info, path_info) != 0));
 							} else {
-								path_info = env_path_info ? env_path_info + pilen - slen : NULL;
-								tflag = (orig_path_info != path_info);
+								path_info = (env_path_info && pilen > slen) ? env_path_info + pilen - slen : NULL;
+								tflag = path_info && (orig_path_info != path_info);
 							}
 
 							if (tflag) {
