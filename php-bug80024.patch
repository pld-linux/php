 .../bug80024-socket-reduced-inherit.phpt      |  49 +++++++
 sapi/fpm/tests/logtool.inc                    |  39 +++++-
 sapi/fpm/tests/tester.inc                     | 124 +++++++++++++++---
 5 files changed, 209 insertions(+), 38 deletions(-)
