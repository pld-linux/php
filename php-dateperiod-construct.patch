From: Ilija Tovilo <ilija.tovilo@me.com>
Subject: Fix leak on double DatePeriod::__construct() call and crash with uninitialised objects

Calling the constructor again leaks start/end/interval, and an uninitialised
DateTime, DateTimeInterface end or DateInterval argument is dereferenced (segfault).
7.3 runs the constructor under EH_THROW, so the checks warn (thrown as an
exception) and restore error handling instead of using DATE_CHECK_INITIALIZED.

Origin: backport, https://github.com/php/php-src/commit/2d86f8cf489ea5410edd19d301c1aefe330599ab
Origin: backport, https://github.com/php/php-src/commit/4833b84854bee04be09983ade42b6e25446cfbbc
Bug: https://github.com/php/php-src/issues/22643
Bug: https://github.com/php/php-src/issues/11416
PLD: taken from packages/php branch PHP_7_1, php-dateperiod-construct.patch
---
 ext/date/php_date.c                               | 31 ++++++++++++-
 .../tests/DatePeriod_double_constructor_call.phpt | 14 ++++++
 ext/date/tests/bug-gh11416.phpt                   | 51 +++++++++++++++++++++
 3 files changed, 95 insertions(+), 1 deletion(-)

diff --git a/ext/date/php_date.c b/ext/date/php_date.c
index f46167bf..3d55a141 100644
--- a/ext/date/php_date.c
+++ b/ext/date/php_date.c
@@ -4422,6 +4422,23 @@ static int date_period_initialize(timelib_time **st, timelib_time **et, timelib_
 	return retval;
 } /* }}} */
 
+static void date_period_reset(php_period_obj *period_obj)
+{
+	if (period_obj->start) {
+		timelib_time_dtor(period_obj->start);
+	}
+	if (period_obj->current) {
+		timelib_time_dtor(period_obj->current);
+	}
+	if (period_obj->end) {
+		timelib_time_dtor(period_obj->end);
+	}
+	if (period_obj->interval) {
+		timelib_rel_time_dtor(period_obj->interval);
+	}
+	memset(period_obj, 0, XtOffsetOf(php_period_obj, std));
+}
+
 /* {{{ proto DatePeriod::__construct(DateTime $start, DateInterval $interval, int recurrences|DateTime $end)
    Creates new DatePeriod object.
 */
@@ -4449,7 +4466,7 @@ PHP_METHOD(DatePeriod, __construct)
 	}
 
 	dpobj = Z_PHPPERIOD_P(getThis());
-	dpobj->current = NULL;
+	date_period_reset(dpobj);
 
 	if (isostr) {
 		date_period_initialize(&(dpobj->start), &(dpobj->end), &(dpobj->interval), &recurrences, isostr, isostr_len);
@@ -4471,6 +4488,18 @@ PHP_METHOD(DatePeriod, __construct)
 		}
 		dpobj->start_ce = date_ce_date;
 	} else {
+		/* check initialisation; the warning is thrown as an exception (EH_THROW) */
+		if (!Z_PHPDATE_P(start)->time || (end && !Z_PHPDATE_P(end)->time)) {
+			php_error_docref(NULL, E_WARNING, "The DateTimeInterface object has not been correctly initialized by its constructor");
+			zend_restore_error_handling(&error_handling);
+			return;
+		}
+		if (!Z_PHPINTERVAL_P(interval)->initialized) {
+			php_error_docref(NULL, E_WARNING, "The DateInterval object has not been correctly initialized by its constructor");
+			zend_restore_error_handling(&error_handling);
+			return;
+		}
+
 		/* init */
 		intobj  = Z_PHPINTERVAL_P(interval);
 
diff --git a/ext/date/tests/DatePeriod_double_constructor_call.phpt b/ext/date/tests/DatePeriod_double_constructor_call.phpt
new file mode 100644
index 00000000..551d2727
--- /dev/null
+++ b/ext/date/tests/DatePeriod_double_constructor_call.phpt
@@ -0,0 +1,14 @@
+--TEST--
+Double DatePeriod::__construct() call
+--FILE--
+<?php
+
+$start = new \DateTime();
+$interval = new \DateInterval('P1D');
+$period = new \DatePeriod($start, $interval, 1);
+$period->__construct($start, $interval, 1);
+
+?>
+===DONE===
+--EXPECT--
+===DONE===
diff --git a/ext/date/tests/bug-gh11416.phpt b/ext/date/tests/bug-gh11416.phpt
new file mode 100644
index 00000000..197acd39
--- /dev/null
+++ b/ext/date/tests/bug-gh11416.phpt
@@ -0,0 +1,51 @@
+--TEST--
+Bug GH-11416: Crash with DatePeriod when uninitialised objects are passed in
+--INI--
+date.timezone=UTC
+--FILE--
+<?php
+$now = new DateTimeImmutable();
+
+$date = (new ReflectionClass(DateTime::class))->newInstanceWithoutConstructor();
+try {
+	new DatePeriod($date, new DateInterval('P1D'), 2);
+} catch (Exception $e) {
+	echo get_class($e), ': ', $e->getMessage(), "\n";
+}
+
+$date = (new ReflectionClass(DateTime::class))->newInstanceWithoutConstructor();
+try {
+	new DatePeriod($now, new DateInterval('P1D'), $date);
+} catch (Exception $e) {
+	echo get_class($e), ': ', $e->getMessage(), "\n";
+}
+
+$interval = (new ReflectionClass(DateInterval::class))->newInstanceWithoutConstructor();
+try {
+	new DatePeriod($now, $interval, 2);
+} catch (Exception $e) {
+	echo get_class($e), ': ', $e->getMessage(), "\n";
+}
+
+/* a failed re-construction leaves an uninitialised period, not a dangling one */
+$period = new DatePeriod($now, new DateInterval('P1D'), 2);
+try {
+	$period->__construct($now, $interval, 2);
+} catch (Exception $e) {
+	echo get_class($e), ': ', $e->getMessage(), "\n";
+}
+try {
+	foreach ($period as $d) {}
+} catch (Error $e) {
+	echo get_class($e), ': ', $e->getMessage(), "\n";
+}
+
+echo "OK\n";
+?>
+--EXPECT--
+Exception: DatePeriod::__construct(): The DateTimeInterface object has not been correctly initialized by its constructor
+Exception: DatePeriod::__construct(): The DateTimeInterface object has not been correctly initialized by its constructor
+Exception: DatePeriod::__construct(): The DateInterval object has not been correctly initialized by its constructor
+Exception: DatePeriod::__construct(): The DateInterval object has not been correctly initialized by its constructor
+Error: DatePeriod has not been initialized correctly
+OK
