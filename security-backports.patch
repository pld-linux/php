+static int php_url_same_origin(const php_url *a, const php_url *b, int default_port)
+{
+	if (!a->scheme || !b->scheme || strcasecmp(a->scheme, b->scheme)) {
+		return 0;
+	}
+	if (!a->host || !b->host || strcasecmp(a->host, b->host)) {
+		return 0;
+	}
+	return (a->port ? a->port : default_port) == (b->port ? b->port : default_port);
+}
