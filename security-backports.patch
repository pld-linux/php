+static void destroy_ref_map(TSRMLS_D)
+{
+	HashTable *ref_map = SOAP_GLOBAL(ref_map);
+	int kind = SOAP_GLOBAL(ref_map_kind);
+
+	/* releasing a zval may run a __destruct() that starts another SOAP pass */
+	SOAP_GLOBAL(ref_map) = NULL;
+	SOAP_GLOBAL(ref_map_kind) = SOAP_REF_MAP_UNUSED;
+	if (kind == SOAP_REF_MAP_DECODE) {
+		HashPosition pos;
+		zval **data;
+
+		for (zend_hash_internal_pointer_reset_ex(ref_map, &pos);
+		     zend_hash_get_current_data_ex(ref_map, (void **)&data, &pos) == SUCCESS;
+		     zend_hash_move_forward_ex(ref_map, &pos)) {
+			/* not zval_ptr_dtor(): it clears is_ref at one holder left and would
+			 * undo the reference an href made; the map is no PHP-visible holder */
+			if (--(*data)->refcount == 0) {
+				zval_dtor(*data);
+				FREE_ZVAL(*data);
+			}
+		}
+	}
+	zend_hash_destroy(ref_map);
+	efree(ref_map);
